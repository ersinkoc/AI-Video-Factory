{
  "name": "ai-video-factory",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "repository": "github:ersinkoc/AI-Video-Factory",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/studio/tsconfig.json",
    "motion:preview": "tsx scripts/preview-scene-motion.ts",
    "typography:preview": "tsx scripts/preview-typography.ts",
    "reference:preview": "tsx scripts/preview-reference-style.ts",
    "audio:audit:preview": "tsx scripts/preview-shot-audio.ts",
    "voice:audit:preview": "tsx scripts/preview-voice-audit.ts",
    "pronunciation:preview": "tsx scripts/preview-pronunciations.ts",
    "quality:preview": "tsx scripts/preview-quality.ts",
    "intent:preview": "tsx scripts/preview-intent.ts",
    "research:preview": "tsx scripts/preview-research.ts",
    "motion:styles:preview": "tsx scripts/preview-style-craft.ts",
    "motion:styles:install": "tsx scripts/install-style-previews.ts",
    "motion:hyperframes:export": "tsx scripts/export-hyperframes-motion.ts",
    "studio": "pnpm --filter @ys/studio dev",
    "studio:build": "pnpm --filter @ys/studio build",
    "studio:start": "pnpm --filter @ys/studio start",
    "release": "tsx scripts/release.ts",
    "bench": "tsx packages/pipeline/scripts/bench.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --mode integration packages/db",
    "ys": "tsx apps/cli/src/index.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
